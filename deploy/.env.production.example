DOMAIN=demo.example.com
ACME_EMAIL=you@example.com

POSTGRES_DB=arachnin
POSTGRES_USER=arachnin
POSTGRES_PASSWORD=replace-with-a-long-random-value

RABBITMQ_USER=arachnin
RABBITMQ_PASSWORD=replace-with-a-different-long-random-value

WORKER_CONCURRENCY=2
FETCH_TIMEOUT_SECONDS=15
MAX_DOCUMENT_BYTES=5000000
MAX_REDIRECTS=3

# Container images. Defaults track the newest published release (:latest).
# Pin an explicit version for reproducible deploys and easy rollback, e.g.
#   BACKEND_IMAGE=ghcr.io/m1hawk005/arachnin-backend:1.4.0
#   FRONTEND_IMAGE=ghcr.io/m1hawk005/arachnin-frontend:1.4.0
BACKEND_IMAGE=ghcr.io/m1hawk005/arachnin-backend:latest
FRONTEND_IMAGE=ghcr.io/m1hawk005/arachnin-frontend:latest
