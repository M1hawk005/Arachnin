# Public ports
FRONTEND_PORT=3000
API_PORT=8080
RABBITMQ_MANAGEMENT_PORT=15672

# PostgreSQL
POSTGRES_DB=arachnin
POSTGRES_USER=arachnin
POSTGRES_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USER=arachnin
RABBITMQ_PASSWORD=change-me

# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
FETCH_TIMEOUT_SECONDS=15
MAX_DOCUMENT_BYTES=5000000
MAX_REDIRECTS=3

# Set by Compose for API and worker containers. These are documented here for local tooling.
DATABASE_URL=postgresql+psycopg://arachnin:change-me@postgres:5432/arachnin
BROKER_URL=amqp://arachnin:change-me@rabbitmq:5672//
REDIS_URL=redis://redis:6379/0
RESULT_BACKEND_URL=redis://redis:6379/1
